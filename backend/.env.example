# Banco local via Docker (rode: docker compose up -d  na raiz do projeto)
DATABASE_URL=postgresql://madeireira:madeireira@localhost:5432/madeireira?schema=public

# Porta da API (padrão: 3000)
# PORT=3000

# Rota do dia (mapa das entregas). Tudo opcional; os padrões usam serviços gratuitos (OpenStreetMap).
# Ponto de partida/retorno dos caminhões (coordenadas aproximadas; confira no mapa e ajuste):
# DEPOSITO_NOME=Madeireira Santa Mônica
# DEPOSITO_ENDERECO=Av. Marginal da Via Anhanguera, 981 - Retiro, Jundiaí/SP
# DEPOSITO_LAT=-23.19116
# DEPOSITO_LNG=-46.90702
# Servidor de rotas OSRM (o público é para uso leve; dá para apontar para um próprio):
# OSRM_URL=https://router.project-osrm.org
# Cidade acrescentada a endereços sem cidade/UF na geocodificação:
# GEOCODE_CONTEXTO=Jundiaí, SP, Brasil
