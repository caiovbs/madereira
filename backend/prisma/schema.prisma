// Schema do app de gestão da madeireira.
// Traduz docs/modelo-de-dados.md (14 entidades). Ver docs/ para regras.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Enums ───────────────────────────
enum EstadoMadeira {
  bruta
  aparelhada
}

enum Funcao {
  aparelhador
  cortador
  carregador
  motorista
}

enum MovimentoSentido {
  entrada
  baixa
}

enum MovimentoOrigem {
  venda
  compra
  ajuste
}

enum VendaStatus {
  orcamento
  fechada
  cancelada
}

enum TipoEntrega {
  retirada
  entrega
}

enum FormaPagamento {
  dinheiro
  pix
  cartao
  prazo
}

enum StatusPagamentoVenda {
  pago
  a_receber
}

enum StatusPagamentoCompra {
  pago
  a_pagar
}

enum CompraStatus {
  pedido
  recebida
  cancelada
}

enum TarefaTipo {
  preparar
  separar
}

enum TarefaStatus {
  pendente
  concluida
}

enum EntregaStatus {
  a_carregar
  carregado
  em_rota
  entregue
  cancelada
}

enum Turno {
  manha
  tarde
}

enum LancSentido {
  entrada
  saida
}

enum LancSituacao {
  previsto
  realizado
}

enum LancOrigem {
  venda
  compra
  avulso
}

enum LancCategoria {
  combustivel
  salario
  energia
  manutencao
  outro
}

// ─────────────────────── Estoque / Produto ───────────────────────
model TipoMadeira {
  id        String    @id @default(uuid()) @db.Uuid
  nome      String    @unique
  ativo     Boolean   @default(true)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  produtos  Produto[]

  @@map("tipo_madeira")
}

model Produto {
  id                  String             @id @default(uuid()) @db.Uuid
  tipoId              String             @db.Uuid
  tipo                TipoMadeira        @relation(fields: [tipoId], references: [id])
  estado              EstadoMadeira
  espessuraCm         Decimal            @db.Decimal(6, 2)
  larguraCm           Decimal            @db.Decimal(6, 2)
  comprimentoEstoqueM Decimal            @db.Decimal(6, 2)
  nome                String // denormalizado (gerado pelo serviço)
  custo               Decimal            @default(0) @db.Decimal(12, 2) // último custo
  preco               Decimal            @default(0) @db.Decimal(12, 2)
  estoqueMinimo       Int                @default(0)
  qtdAtual            Int                @default(0) // cache do razão (MovimentoEstoque)
  ativo               Boolean            @default(true)
  createdAt           DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime           @updatedAt @db.Timestamptz(6)
  movimentos          MovimentoEstoque[]
  itensVenda          ItemVenda[]
  itensCompra         ItemCompra[]

  @@unique([tipoId, estado, espessuraCm, larguraCm, comprimentoEstoqueM])
  @@index([nome])
  @@map("produto")
}

model MovimentoEstoque {
  id         String           @id @default(uuid()) @db.Uuid
  produtoId  String           @db.Uuid
  produto    Produto          @relation(fields: [produtoId], references: [id])
  sentido    MovimentoSentido
  quantidade Int
  origemTipo MovimentoOrigem
  origemId   String?          @db.Uuid // venda ou compra de origem
  custoUnit  Decimal?         @db.Decimal(12, 2) // preenchido nas entradas
  observacao String?
  createdAt  DateTime         @default(now()) @db.Timestamptz(6)

  @@index([produtoId])
  @@map("movimento_estoque")
}

// ─────────────────────────── Cadastros ───────────────────────────
model Cliente {
  id        String   @id @default(uuid()) @db.Uuid
  nome      String
  telefone  String?
  endereco  String?
  documento String?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  vendas    Venda[]

  @@map("cliente")
}

model Fornecedor {
  id         String   @id @default(uuid()) @db.Uuid
  nome       String
  telefone   String?
  observacao String?
  ativo      Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  compras    Compra[]

  @@map("fornecedor")
}

model Funcionario {
  id        String    @id @default(uuid()) @db.Uuid
  nome      String
  funcoes   Funcao[]
  telefone  String?
  ativo     Boolean   @default(true)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  entregas  Entrega[] // como motorista

  @@map("funcionario")
}

model Caminhao {
  id        String    @id @default(uuid()) @db.Uuid
  descricao String
  placa     String?
  ativo     Boolean   @default(true)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  entregas  Entrega[]

  @@map("caminhao")
}

// ─────────────────────────── Venda ───────────────────────────
model Venda {
  id              String                 @id @default(uuid()) @db.Uuid
  numero          Int                    @unique @default(autoincrement())
  clienteId       String?                @db.Uuid
  cliente         Cliente?               @relation(fields: [clienteId], references: [id])
  obraRef         String?
  status          VendaStatus            @default(orcamento)
  tipoEntrega     TipoEntrega            @default(retirada)
  subtotal        Decimal                @default(0) @db.Decimal(12, 2)
  frete           Decimal                @default(0) @db.Decimal(12, 2)
  desconto        Decimal                @default(0) @db.Decimal(12, 2)
  total           Decimal                @default(0) @db.Decimal(12, 2)
  formaPagamento  FormaPagamento?
  statusPagamento StatusPagamentoVenda?
  dataVenda       DateTime?              @db.Timestamptz(6)
  createdAt       DateTime               @default(now()) @db.Timestamptz(6)
  itens           ItemVenda[]
  tarefas         TarefaPatio[]
  entrega         Entrega?
  lancamentos     LancamentoFinanceiro[]

  @@map("venda")
}

model ItemVenda {
  id            String        @id @default(uuid()) @db.Uuid
  vendaId       String        @db.Uuid
  venda         Venda         @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  produtoId     String        @db.Uuid
  produto       Produto       @relation(fields: [produtoId], references: [id])
  quantidade    Int
  precoUnit     Decimal       @db.Decimal(12, 2) // snapshot do preço
  cortarParaM   Decimal?      @db.Decimal(6, 2)
  aparelhar     Boolean       @default(false)
  subtotalLinha Decimal       @default(0) @db.Decimal(12, 2)
  tarefas       TarefaPatio[]

  @@index([vendaId])
  @@map("item_venda")
}

// ─────────────────────────── Compra ───────────────────────────
model Compra {
  id              String                 @id @default(uuid()) @db.Uuid
  numero          Int                    @unique @default(autoincrement())
  fornecedorId    String?                @db.Uuid
  fornecedor      Fornecedor?            @relation(fields: [fornecedorId], references: [id])
  status          CompraStatus           @default(pedido)
  total           Decimal                @default(0) @db.Decimal(12, 2)
  statusPagamento StatusPagamentoCompra?
  formaPagamento  FormaPagamento?
  vencimento      DateTime?              @db.Date
  dataPedido      DateTime               @default(now()) @db.Timestamptz(6)
  dataRecebida    DateTime?              @db.Timestamptz(6)
  createdAt       DateTime               @default(now()) @db.Timestamptz(6)
  itens           ItemCompra[]
  lancamentos     LancamentoFinanceiro[]

  @@map("compra")
}

model ItemCompra {
  id            String  @id @default(uuid()) @db.Uuid
  compraId      String  @db.Uuid
  compra        Compra  @relation(fields: [compraId], references: [id], onDelete: Cascade)
  produtoId     String  @db.Uuid
  produto       Produto @relation(fields: [produtoId], references: [id])
  quantidade    Int
  custoUnit     Decimal @db.Decimal(12, 2)
  subtotalLinha Decimal @default(0) @db.Decimal(12, 2)

  @@index([compraId])
  @@map("item_compra")
}

// ─────────────────────────── Pátio ───────────────────────────
model TarefaPatio {
  id                String       @id @default(uuid()) @db.Uuid
  vendaId           String       @db.Uuid
  venda             Venda        @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  itemVendaId       String?      @db.Uuid
  itemVenda         ItemVenda?   @relation(fields: [itemVendaId], references: [id], onDelete: Cascade)
  tipo              TarefaTipo
  status            TarefaStatus @default(pendente)
  corteConcluido    Boolean      @default(false)
  aparelhoConcluido Boolean      @default(false)
  concluidaEm       DateTime?    @db.Timestamptz(6)
  createdAt         DateTime     @default(now()) @db.Timestamptz(6)

  @@index([vendaId])
  @@map("tarefa_patio")
}

// ─────────────────────────── Entrega ───────────────────────────
model Entrega {
  id           String        @id @default(uuid()) @db.Uuid
  vendaId      String        @unique @db.Uuid
  venda        Venda         @relation(fields: [vendaId], references: [id])
  status       EntregaStatus @default(a_carregar)
  caminhaoId   String?       @db.Uuid
  caminhao     Caminhao?     @relation(fields: [caminhaoId], references: [id])
  motoristaId  String?       @db.Uuid
  motorista    Funcionario?  @relation(fields: [motoristaId], references: [id])
  endereco     String?
  observacao   String?
  dataAgendada DateTime?     @db.Date
  turno        Turno?
  latitude     Float? // geocodificado do endereço; ajustável no mapa
  longitude    Float?
  ordemRota    Int? // posição na rota do dia (1 = primeira parada)
  carregadoEm  DateTime?     @db.Timestamptz(6)
  saiuEm       DateTime?     @db.Timestamptz(6)
  entregueEm   DateTime?     @db.Timestamptz(6)
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)

  @@map("entrega")
}

// ─────────────────────────── Financeiro ───────────────────────────
model LancamentoFinanceiro {
  id            String         @id @default(uuid()) @db.Uuid
  sentido       LancSentido
  situacao      LancSituacao
  origemTipo    LancOrigem
  vendaId       String?        @db.Uuid
  venda         Venda?         @relation(fields: [vendaId], references: [id])
  compraId      String?        @db.Uuid
  compra        Compra?        @relation(fields: [compraId], references: [id])
  descricao     String
  categoria     LancCategoria?
  valor         Decimal        @db.Decimal(12, 2)
  vencimento    DateTime?      @db.Date
  dataRealizado DateTime?      @db.Timestamptz(6)
  createdAt     DateTime       @default(now()) @db.Timestamptz(6)

  @@index([situacao])
  @@map("lancamento_financeiro")
}
