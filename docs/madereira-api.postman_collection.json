          "event": [{ "listen": "test", "script": { "exec": ["const data = pm.response.json().data;", "if (data && data.length > 0) {", "  pm.collectionVariables.set('entregaId', data[0].id);", "}", "pm.test('Status 200', () => pm.response.to.have.status(200));"] } }],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/entregas?vendaId={{vendaId}}", "host": ["{{baseUrl}}"], "path": ["entregas"], "query": [{ "key": "vendaId", "value": "{{vendaId}}" }] }
          }
        },
        {
          "name": "14 - Configurar Entrega (Motorista + Caminhão)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"] } }],
          "request": {
            "method": "PATCH", "url": "{{baseUrl}}/entregas/{{entregaId}}",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"motoristaId\": \"{{funcionarioId}}\",\n  \"caminhaoId\": \"{{caminhaoId}}\",\n  \"endereco\": \"Rua das Flores, 123\",\n  \"dataAgendada\": \"2026-07-01\",\n  \"turno\": \"manha\"\n}" }
          }
        },
        {
          "name": "15 - Avançar Entrega → carregado",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 201', () => pm.response.to.have.status(201));", "pm.test('Status carregado', () => pm.expect(pm.response.json().data.status).to.eql('carregado'));"] } }],
          "request": { "method": "POST", "url": "{{baseUrl}}/entregas/{{entregaId}}/avancar" }
        },
        {
          "name": "16 - Avançar Entrega → em_rota",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 201', () => pm.response.to.have.status(201));", "pm.test('Status em_rota', () => pm.expect(pm.response.json().data.status).to.eql('em_rota'));"] } }],
          "request": { "method": "POST", "url": "{{baseUrl}}/entregas/{{entregaId}}/avancar" }
        },
        {
          "name": "17 - Avançar Entrega → entregue",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 201', () => pm.response.to.have.status(201));", "pm.test('Status entregue', () => pm.expect(pm.response.json().data.status).to.eql('entregue'));"] } }],
          "request": { "method": "POST", "url": "{{baseUrl}}/entregas/{{entregaId}}/avancar" }
        },
        {
          "name": "18 - Ver Caixa",
          "event": [{ "listen": "test", "script": { "exec": ["const d = pm.response.json().data;", "pm.test('Status 200', () => pm.response.to.have.status(200));", "pm.test('Tem saldo', () => pm.expect(d).to.have.property('saldo'));", "console.log('Caixa:', JSON.stringify(d));"] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/financeiro/caixa" }
        }
