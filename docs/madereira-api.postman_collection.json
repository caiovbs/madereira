          "request": {
            "method": "POST", "url": "{{baseUrl}}/clientes",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"João da Silva\",\n  \"telefone\": \"11988880000\",\n  \"endereco\": \"Rua das Flores, 123\"\n}" }
          }
        },
        {
          "name": "07 - Criar Funcionário (Motorista)",
          "event": [{ "listen": "test", "script": { "exec": ["const d = pm.response.json().data;", "pm.collectionVariables.set('funcionarioId', d.id);", "pm.test('Status 201', () => pm.response.to.have.status(201));"] } }],
          "request": {
            "method": "POST", "url": "{{baseUrl}}/funcionarios",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
