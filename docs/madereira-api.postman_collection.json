          "request": {
            "method": "POST", "url": "{{baseUrl}}/caminhoes",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"descricao\": \"Fiat Ducato Branco\",\n  \"placa\": \"ABC-1234\"\n}" }
          }
        },
        {
          "name": "09 - Criar Venda (Orçamento) — com corte",
          "event": [{ "listen": "test", "script": { "exec": ["const d = pm.response.json().data;", "pm.collectionVariables.set('vendaId', d.id);", "pm.test('Status 201', () => pm.response.to.have.status(201));", "pm.test('Status orcamento', () => pm.expect(d.status).to.eql('orcamento'));"] } }],
          "request": {
            "method": "POST", "url": "{{baseUrl}}/vendas",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"clienteId\": \"{{clienteId}}\",\n  \"obraRef\": \"Obra Rua das Flores\",\n  \"tipoEntrega\": \"entrega\",\n  \"itens\": [\n    {\n      \"produtoId\": \"{{produtoId}}\",\n      \"quantidade\": 10,\n      \"cortarParaM\": 2.5,\n      \"aparelhar\": false\n    }\n  ],\n  \"frete\": 50.00,\n  \"desconto\": 0\n}" }
          }
        },
        {
          "name": "10 - Fechar Venda",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 201', () => pm.response.to.have.status(201));", "pm.test('Status fechada', () => pm.expect(pm.response.json().data.status).to.eql('fechada'));"] } }],
          "request": {
            "method": "POST", "url": "{{baseUrl}}/vendas/{{vendaId}}/fechar",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"formaPagamento\": \"dinheiro\"\n}" }
          }
        },
        {
          "name": "11 - Listar Tarefas da Venda",
          "event": [{ "listen": "test", "script": { "exec": ["const data = pm.response.json().data;", "if (data && data.length > 0) {", "  pm.collectionVariables.set('tarefaId', data[0].id);", "}", "pm.test('Status 200', () => pm.response.to.have.status(200));", "pm.test('Tem tarefas', () => pm.expect(data.length).to.be.above(0));"] } }],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/patio/tarefas?vendaId={{vendaId}}", "host": ["{{baseUrl}}"], "path": ["patio", "tarefas"], "query": [{ "key": "vendaId", "value": "{{vendaId}}" }] }
          }
        },
        {
          "name": "12 - Concluir Tarefa",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 201', () => pm.response.to.have.status(201));", "pm.test('Status concluida', () => pm.expect(pm.response.json().data.status).to.eql('concluida'));"] } }],
