# Copie para deploy/.env (não versionado). Gere a senha com: openssl rand -hex 16
DB_PASSWORD=troque-esta-senha

# Porta publicada do web (Caddy). Padrão: 80.
# WEB_PORT=80

# Imagens a usar (ex.: as publicadas no GHCR pelo CD). Padrão: build local.
# API_IMAGE=ghcr.io/caiovbs/madereira-api:latest
# WEB_IMAGE=ghcr.io/caiovbs/madereira-web:latest

# Opcionais da Rota do dia, repassados para a API (ver backend/.env.example):
